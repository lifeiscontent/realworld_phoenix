<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-zinc-100 py-3">
    <div class="flex items-center gap-6">
      <.link navigate={~p"/"} class="text-2xl font-bold text-brand">
        Realworld
      </.link>
      
      <nav class="flex items-center gap-4">
        <.link navigate={~p"/articles"} class="text-sm font-medium hover:text-brand">
          Articles
        </.link>
        <%= if @current_user do %>
          <.link navigate={~p"/following/articles"} class="text-sm font-medium hover:text-brand">
            Following
          </.link>
        <% end %>
      </nav>
    </div>
    
    <div class="flex items-center gap-4">
      <%= if @current_user do %>
        <.link navigate={~p"/articles/new"} class="text-sm font-medium hover:text-brand">
          <.icon name="hero-pencil-square" class="h-4 w-4 inline mr-1" />
          Write
        </.link>
        <.link navigate={~p"/profiles/#{@current_user.username}"} class="text-sm font-medium hover:text-brand flex items-center">
          <%= if @current_user.image do %>
            <img src={@current_user.image} alt={@current_user.username} class="w-8 h-8 rounded-full" />
          <% else %>
            <div class="w-8 h-8 rounded-full bg-brand/20 flex items-center justify-center text-brand font-semibold">
              <%= String.first(@current_user.username) |> String.upcase() %>
            </div>
          <% end %>
          <span class="ml-2"><%= @current_user.username %></span>
        </.link>
        <.link navigate={~p"/users/settings"} class="text-sm font-medium hover:text-brand">
          <.icon name="hero-cog-6-tooth" class="h-5 w-5" />
        </.link>
        <.link href={~p"/users/log_out"} method="delete" class="text-sm font-medium hover:text-brand">
          Sign out
        </.link>
      <% else %>
        <.link navigate={~p"/users/log_in"} class="text-sm font-medium hover:text-brand">
          Sign in
        </.link>
        <.link navigate={~p"/users/register"} class="text-sm font-medium hover:text-brand">
          Sign up
        </.link>
      <% end %>
    </div>
  </div>
</header>
<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
