<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-zinc-100 py-3">
    <div class="flex items-center gap-6">
      <.link navigate={~p"/"} class="text-2xl font-bold text-brand">
        Realworld
      </.link>

      <nav class="flex items-center gap-4">
        <.link navigate={~p"/articles"} class="text-sm font-medium hover:text-brand">
          Articles
        </.link>
        <%= if @current_user do %>
          <.link navigate={~p"/following/articles"} class="text-sm font-medium hover:text-brand">
            Following
          </.link>
        <% end %>
      </nav>
    </div>

    <div class="flex items-center gap-4">
      <%= if @current_user do %>
        <.link navigate={~p"/articles/new"} class="text-sm font-medium hover:text-brand">
          <.icon name="hero-pencil-square" class="h-4 w-4 inline mr-1" /> Write
        </.link>
        <.link
          navigate={~p"/profiles/#{@current_user}"}
          class="text-sm font-medium hover:text-brand flex items-center"
        >
          <.user_avatar user={@current_user} size="sm" class="mr-2" />
          <span>{@current_user.username}</span>
        </.link>
        <.link navigate={~p"/users/settings"} class="text-sm font-medium hover:text-brand">
          <.icon name="hero-cog-6-tooth" class="h-5 w-5" />
        </.link>
        <.link
          href={~p"/users/log_out"}
          method="delete"
          class="text-sm font-medium hover:text-brand"
        >
          Sign out
        </.link>
      <% else %>
        <.link navigate={~p"/users/log_in"} class="text-sm font-medium hover:text-brand">
          Sign in
        </.link>
        <.link navigate={~p"/users/register"} class="text-sm font-medium hover:text-brand">
          Sign up
        </.link>
      <% end %>
    </div>
  </div>
</header>
<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
