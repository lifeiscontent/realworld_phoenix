<div class="mb-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">{@article.title}</h1>
  
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <.user_avatar user={@article.user} link={true} size="md" />
      <div>
        <.link navigate={~p"/profiles/#{@article.user}"} class="font-semibold text-gray-900 hover:text-brand">
          @{@article.user.username}
        </.link>
        <div class="text-sm text-gray-500">
          {format_datetime(@article.inserted_at, @time_zone)}
        </div>
      </div>
    </div>
    
    <div class="flex items-center gap-3">
      <%= if @can_edit? do %>
        <.link patch={~p"/articles/#{@article}/show/edit"} phx-click={JS.push_focus()}>
          <.button variant="secondary">Edit article</.button>
        </.link>
      <% end %>
    </div>
  </div>
</div>

<div class="flex items-center gap-4 mb-6 pb-6 border-b border-gray-200">
  <%= if @can_favorite? do %>
    <.button
      phx-click="toggle_favorite"
      variant={if @article.favorited, do: "primary", else: "outline"}
      class="flex items-center gap-2"
    >
      <span class="text-lg">{if @article.favorited, do: "❤️", else: "🤍"}</span>
      <span>{@article.favorites_count} {if @article.favorites_count == 1, do: "like", else: "likes"}</span>
    </.button>
  <% else %>
    <div class="flex items-center gap-2 px-4 py-2 text-gray-600 bg-gray-50 rounded-lg">
      <span class="text-lg">🤍</span>
      <span>{@article.favorites_count} {if @article.favorites_count == 1, do: "like", else: "likes"}</span>
    </div>
  <% end %>
  
  <div class="text-sm text-gray-500">
    Status: <span class="font-medium capitalize">{@article.status}</span>
  </div>
</div>

<%= if @article.tags != [] do %>
  <div class="mb-8">
    <.tag_list tags={@article.tags} />
  </div>
<% end %>

<div class="prose max-w-none my-12">
  <div class="text-lg leading-relaxed whitespace-pre-wrap text-gray-800">
    {@article.body}
  </div>
</div>

<hr class="my-8" />

<div class="mt-8">
  <h2 class="text-xl font-semibold mb-4">Comments</h2>

  <%= if @can_comment? do %>
    <.simple_form for={@comment_form} id="comment-form" phx-submit="save_comment" class="mb-6">
      <.input field={@comment_form[:user_id]} type="hidden" />
      <.input field={@comment_form[:article_id]} type="hidden" />
      <.input field={@comment_form[:content]} type="textarea" label="Add a comment" rows="3" />
      <:actions>
        <.button>Post Comment</.button>
      </:actions>
    </.simple_form>
  <% else %>
    <%= if @current_user do %>
      <p class="text-gray-600 mb-6">Comments are disabled for this article.</p>
    <% else %>
      <p class="text-gray-600 mb-6">
        <.link navigate={~p"/users/log_in"} class="font-semibold text-brand hover:underline">
          Log in
        </.link>
        to comment.
      </p>
    <% end %>
  <% end %>

  <div id="comments" phx-update="stream" class="space-y-4">
    <p id="comments-empty" class="text-gray-600 only:block hidden">
      No comments yet. Be the first to comment!
    </p>
    <div :for={{dom_id, comment} <- @streams.comments} id={dom_id}>
      <.comment comment={comment} current_user={@current_user} time_zone={@time_zone} />
    </div>
  </div>
</div>

<.back navigate={~p"/articles"}>Back to articles</.back>

<.modal
  :if={@live_action == :edit}
  id="article-modal"
  show
  on_cancel={JS.patch(~p"/articles/#{@article}")}
>
  <.live_component
    module={RealworldWeb.ArticleLive.FormComponent}
    id={@article.id}
    title={@page_title}
    action={@live_action}
    article={@article}
    current_user={@current_user}
    patch={~p"/articles/#{@article}"}
  />
</.modal>
